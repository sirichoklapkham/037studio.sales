                                </button>

                                <button onclick="markAsFullyPaid('${b.id}', ${b.totalPrice})" 
                                        class="py-2 px-2 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl text-[11px] transition flex items-center justify-center gap-1 shadow-sm active:scale-95">
                                    <i data-lucide="check-circle-2" class="w-3.5 h-3.5"></i>
                                    <span>✅ ชำระครบแล้ว</span>
                                </button>
                            </div>
                        </div>
                    `;
                });
            } else {
                container.innerHTML = `<div class="bg-white p-6 rounded-2xl text-center text-xs text-slate-400 border border-slate-200">ไม่มีคิวจองในวันที่เลือก</div>`;
            }

            renderIcons();
        }

        async function checkPublicReceiptMode() {
            const urlParams = new URLSearchParams(window.location.search);
            const receiptId = urlParams.get('receipt');
            const type = urlParams.get('type') || 'studio';

            if (receiptId) {
                document.getElementById("mainAdminApp").classList.add("hidden");
                document.getElementById("standaloneReceipt").classList.remove("hidden");

                try {
                    const res = await fetch(`${SCRIPT_URL}?action=getBookingById&bookingId=${receiptId}&type=${type}`, { redirect: "follow" }).then(r => r.json());
                    
                    if (res && res.status === "success" && res.data) {
                        standaloneBookingObj = res.data;
                        renderStandaloneReceipt(res.data);
                    } else {
                        document.getElementById("standaloneReceiptCard").innerHTML = `
                            <div class="text-center p-6 space-y-3">
                                <i data-lucide="alert-circle" class="w-12 h-12 text-amber-500 mx-auto"></i>
                                <h3 class="font-bold text-slate-800">ไม่พบข้อมูลใบจองนี้ในระบบ</h3>
                                <p class="text-xs text-slate-500">กรุณาตรวจสอบลิงก์อีกครั้ง หรือติดต่อทางร้าน 037Studio</p>
                            </div>
                        `;
                        renderIcons();
                    }
                } catch (err) {
                    console.error("Fetch Public Receipt Error:", err);
                }
                return true;
            }
            return false;
        }

        function renderStandaloneReceipt(b) {
            const bNo = b.title.match(/#([0-9A-Z]+)/i);
            document.getElementById("stRecBookingNo").innerText = bNo ? `#${bNo[1]}` : `#${b.id.substring(0, 8)}`;
            
            document.getElementById("stRecTime").innerText = `${b.time} น.`;
            document.getElementById("stRecDate").innerText = formatDateToDDMMYYYY(b.date);

            const nameMatch = (b.title + "\n" + b.desc).match(/(?:ชื่อ|ชื่อเล่น)\s*[:=]?\s*([^\n\r]+)/i);
            document.getElementById("stRecCustName").innerText = nameMatch ? nameMatch[1].trim() : b.title;

            const phoneMatch = (b.title + "\n" + b.desc).match(/(?:โทร|เบอร์โทรศัพท์)\s*[:=]?\s*(\+?[0-9-]+)/i);
            document.getElementById("stRecCustPhone").innerText = phoneMatch ? phoneMatch[1].trim() : "ไม่ระบุ";

            document.getElementById("stRecPackage").innerText = b.title;
            
            if (b.location) {
                document.getElementById("stRecLocationRow").classList.remove("hidden");
                document.getElementById("stRecLocation").innerText = b.location;
            } else {
                document.getElementById("stRecLocationRow").classList.add("hidden");
            }

            if (b.desc && b.desc.includes("[ปรับเลื่อนเวลาแล้ว]")) {
                const historyMatch = b.desc.match(/\[ปรับเลื่อนเวลาแล้ว\][\s\S]*/);
                if (historyMatch) {
                    const cleanedHistory = cleanHistoryText(historyMatch[0]);
                    document.getElementById("stRecHistoryRow").classList.remove("hidden");
                    document.getElementById("stRecHistoryText").innerText = cleanedHistory;
                }
            } else {
                document.getElementById("stRecHistoryRow").classList.add("hidden");
            }

            const total = Number(b.totalPrice || 0);
            const deposit = Number(b.depositPrice || 0);
            const balance = Math.max(0, total - deposit);

            document.getElementById("stRecTotalAmt").innerText = `฿${total.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
            document.getElementById("stRecDepositAmt").innerText = `฿${deposit.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
            document.getElementById("stRecBalanceAmt").innerText = `฿${balance.toLocaleString('th-TH', {minimumFractionDigits: 2})}`;
            
            renderIcons();
        }

        async function submitDepositAndSlip() {
            const bookingId = document.getElementById("modalBookingId").value;
            const depositAmount = document.getElementById("inputDepositAmount").value;
            const fileInput = document.getElementById("inputSlipFile");

            const btnSave = document.getElementById("btnSaveDeposit");
            btnSave.disabled = true;
            btnSave.innerHTML = `<div class="animate-spin rounded-full h-3.5 w-3.5 border-b-2 border-slate-900"></div> <span>กำลังบันทึก...</span>`;

            let slipBase64 = "";
            let slipFileName = "";

            if (fileInput.files && fileInput.files[0]) {
                const file = fileInput.files[0];
                slipFileName = file.name;
                slipBase64 = await new Promise((resolve) => {
                    const reader = new FileReader();
                    reader.onload = (e) => resolve(e.target.result);
                    reader.readAsDataURL(file);
                });
            }

            try {
                const payload = {
                    action: "updateDeposit",
                    type: currentTab,
                    bookingId: bookingId,
                    depositAmount: depositAmount,
                    slipBase64: slipBase64,
                    slipFileName: slipFileName
                };

                await fetch(SCRIPT_URL, {
                    method: "POST",
                    headers: { "Content-Type": "text/plain;charset=utf-8" },
                    body: JSON.stringify(payload)
                });

                alert("บันทึกข้อมูลเรียบร้อยแล้ว");
                toggleDepositModal(false);
                await initApp(true);

            } catch (err) {
                alert("เกิดข้อผิดพลาดในการบันทึก: " + err.message);
            } finally {
                btnSave.disabled = false;
                btnSave.innerHTML = `<span>บันทึกข้อมูล</span>`;
            }
        }

        function handleError(err) {
            document.getElementById("loadingIndicator").classList.add("hidden");
            alert("ไม่สามารถดึงข้อมูลได้: " + (err.message || err));
        }

        window.onload = async () => {
            checkStaffModeFromUrl();
            const isPublicMode = await checkPublicReceiptMode();
            if (!isPublicMode) {
                initApp();
            }
        };
    </script>
</body>
</html>
