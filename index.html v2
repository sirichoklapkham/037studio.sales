    <script>
        const DEFAULT_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwGQ9iLaOcRKunCZBUOc0-szn2NYana6NuM7F2oCUxPc4Z_qKroyQ3NoME1wIhStjJs/exec";
        let SCRIPT_URL = DEFAULT_SCRIPT_URL;

        let currentTab = "studio";
        let isStaffMode = false;
        let isLockedByUrl = false;
        let isCommCollapsed = false;
        let currentYear = new Date().getFullYear();
        let currentMonth = new Date().getMonth();
        let selectedDateStr = new Date().toISOString().split('T')[0];
        
        let monthlyDataCache = {};
        let dailyDataCache = {};
        let activeReceiptData = null;
        let standaloneBookingObj = null;
        let pendingDeleteId = null;

        const thaiMonths = ["มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน", "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"];

        function isEligibleCommissionPackage(title) {
            // ยกเลิกคอมมิชชั่นเมื่ออยู่ในหมวด PhotoBooth
            if (currentTab === 'photobooth') return false;
            
            if (!title) return false;
            const clean = title.toString().trim().toLowerCase();

            if (clean.includes("ออกแบบ") || clean.includes("กราฟิก") || clean.includes("แต่งรูป") || clean.includes("ไฟล์รูป")) {
                return false;
            }
            return true;
        }

        function getNormalizedPackageName(rawTitle) {
            if (!rawTitle) return "แพ็กเกจทั่วไป";
            let name = rawTitle.split('-')[0].trim();

            if (name.includes("เซลฟี่สตูดิโอ ครึ่งตัว")) return "เซลฟี่สตูดิโอ (ครึ่งตัว)";
            if (name.includes("เซลฟี่สตูดิโอ เต็มตัว")) return "เซลฟี่สตูดิโอ (เต็มตัว/ครึ่งตัว)";
            if (name.includes("ถ่ายโปรไฟล์ พร้อมช่างภาพ")) return "ถ่ายโปรไฟล์ พร้อมช่างภาพ";
            if (name.includes("เช่าสตูดิโอ เฉพาะสถานที่")) return "เช่าสตูดิโอ (เฉพาะสถานที่)";
            if (name.includes("เช่าสตูดิโอ พร้อมช่างภาพ")) return "เช่าสตูดิโอ (พร้อมช่างภาพ)";

            return name;
        }

        function getBaseCommissionOnly(title) {
            if (currentTab === 'photobooth') return 0;
            if (!title || !isEligibleCommissionPackage(title)) return 0;
            const cleanTitle = title.toString().trim();
            if (cleanTitle.includes("เซลฟี่สตูดิโอ ครึ่งตัว") || cleanTitle.includes("ครึ่งตัว 10 นาที") || cleanTitle.includes("ครึ่งตัว 20 นาที")) {
                return 10;
            }
            return 20;
        }

        function getBonusCommissionOnly(desc = "") {
            if (currentTab === 'photobooth') return 0;
            if (!desc) return 0;
            const bonusMatch = desc.match(/คอมฯ พิเศษ\s*[:=]?\s*([0-9,-.]+)/i);
            return bonusMatch ? (parseFloat(bonusMatch[1].replace(/,/g, '')) || 0) : 0;
        }

        function getCommissionAmount(title, desc = "") {
            if (currentTab === 'photobooth') return 0;
            return getBaseCommissionOnly(title) + getBonusCommissionOnly(desc);
        }

        function renderIcons() {
            if (window.lucide) lucide.createIcons();
        }

        function formatDateToDDMMYYYY(dateStr) {
            if (!dateStr) return '';
            const parts = String(dateStr).split('T')[0].split('-');
            if (parts.length === 3) return `${parts[2]}-${parts[1]}-${parts[0]}`;
            return dateStr;
        }

        function toggleCommissionCollapse() {
            isCommCollapsed = !isCommCollapsed;
            const content = document.getElementById("commCollapsibleContent");
            const lbl = document.getElementById("lblCollapseComm");
            const icon = document.getElementById("iconCollapseComm");

            if (isCommCollapsed) {
                content.classList.add("hidden");
                lbl.innerText = "ขยายออก";
                icon.setAttribute("data-lucide", "chevron-down");
            } else {
                content.classList.remove("hidden");
                lbl.innerText = "พับเก็บ";
                icon.setAttribute("data-lucide", "chevron-up");
            }
            renderIcons();
        }

        function applyPackagePreset(val) {
            if (!val) return;
            const parts = val.split('|');
            const name = parts[0];
            const price = Number(parts[1]) || 0;

            document.getElementById("addPackageName").value = name;
            document.getElementById("addTotalAmt").value = price;
            document.getElementById("addDiscountAmt").value = '';
            document.getElementById("addDepositAmt").value = Math.round(price * 0.5);
        }

        function calculateNetTotal() {
            const rawPrice = Number(document.getElementById("addTotalAmt").value) || 0;
            const discount = Number(document.getElementById("addDiscountAmt").value) || 0;
            const netPrice = Math.max(0, rawPrice - discount);
            document.getElementById("addDepositAmt").value = Math.round(netPrice * 0.5);
        }

        function toggleCommissionDetailModal(show) {
            if (currentTab === 'photobooth') return;
            const modal = document.getElementById("commissionDetailModal");
            if (show) {
                document.getElementById("modalCommMonthLabel").innerText = `${thaiMonths[currentMonth]} ${currentYear}`;
                modal.classList.remove("hidden");
            } else {
                modal.classList.add("hidden");
            }
        }

        function openBonusCommissionModal(bookingId, currentBonus) {
            document.getElementById("bonusBookingId").value = bookingId;
            document.getElementById("inputBonusAmount").value = currentBonus || '';
            toggleBonusCommissionModal(true);
        }

        function toggleBonusCommissionModal(show) {
            const modal = document.getElementById("bonusCommissionModal");
            if (show) modal.classList.remove("hidden");
            else modal.classList.add("hidden");
        }

        async function submitBonusCommission() {
            const bookingId = document.getElementById("bonusBookingId").value;
            const bonusAmount = document.getElementById("inputBonusAmount").value;

            const btn = document.getElementById("btnSaveBonusComm");
            btn.disabled = true;
            btn.innerText = "กำลังบันทึก...";

            try {
                const payload = {
                    action: "updateBonusCommission",
                    type: currentTab,
                    bookingId: bookingId,
                    bonusAmount: bonusAmount
                };

                await fetch(SCRIPT_URL, {
                    method: "POST",
                    headers: { "Content-Type": "text/plain;charset=utf-8" },
                    body: JSON.stringify(payload)
                });

                alert("อัปเดตคอมมิชชั่นพิเศษเรียบร้อยแล้ว!");
                toggleBonusCommissionModal(false);
                await initApp(true);

            } catch (err) {
                alert("เกิดข้อผิดพลาดในการบันทึก: " + err.message);
            } finally {
                btn.disabled = false;
                btn.innerText = "บันทึกคอมมิชชั่นพิเศษ";
            }
        }

        async function markAsFullyPaid(bookingId, totalPrice) {
            const loading = document.getElementById("loadingIndicator");
            document.getElementById("loadingText").innerText = "กำลังอัปเดตเป็นชำระครบแล้ว...";
            loading.classList.remove("hidden");

            try {
                const payload = {
                    action: "updateDeposit",
                    type: currentTab,
                    bookingId: bookingId,
                    depositAmount: totalPrice,
                    slipBase64: "",
                    slipFileName: ""
                };

                await fetch(SCRIPT_URL, {
                    method: "POST",
                    headers: { "Content-Type": "text/plain;charset=utf-8" },
                    body: JSON.stringify(payload)
                });

                alert("อัปเดตเป็นชำระครบแล้วเรียบร้อย!");
                await initApp(true);
            } catch (err) {
                alert("เกิดข้อผิดพลาดในการอัปเดต: " + err.message);
            } finally {
                loading.classList.add("hidden");
            }
        }

        function getReceiptPublicUrl(bookingId) {
            const baseUrl = window.location.origin + window.location.pathname;
            return `${baseUrl}?receipt=${bookingId}&type=${currentTab}`;
        }

        function copyStaffModeLink() {
            const baseUrl = window.location.origin + window.location.pathname;
            const staffUrl = `${baseUrl}?mode=staff`;
            navigator.clipboard.writeText(staffUrl).then(() => {
                alert("คัดลอกลิงก์โหมดพนักงานเรียบร้อยแล้ว!\nนำไปส่งให้พนักงานร้านใช้งานได้ทันที:\n" + staffUrl);
