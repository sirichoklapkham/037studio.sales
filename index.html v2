        function changeMonth(delta) {
            currentMonth += delta;
            if (currentMonth < 0) { currentMonth = 11; currentYear--; }
            else if (currentMonth > 11) { currentMonth = 0; currentYear++; }
            initApp(true);
        }

        function renderCalendar() {
            const grid = document.getElementById("calendarGrid");
            grid.innerHTML = "";

            const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
            const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();

            for (let i = 0; i < firstDayIndex; i++) {
                grid.innerHTML += `<div class="h-11"></div>`;
            }

            for (let day = 1; day <= totalDays; day++) {
                const dateKey = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const isSelected = (dateKey === selectedDateStr);
                const dayData = monthlyDataCache[dateKey];

                let countText = "";
                let dotColorClass = "hidden";

                if (dayData && dayData.count > 0) {
                    countText = `${dayData.count} คิว`;
                    if (dayData.totalDeposit >= dayData.totalSales && dayData.totalSales > 0) {
                        dotColorClass = "bg-pink-400";
                    } else if (dayData.totalDeposit > 0) {
                        dotColorClass = "bg-emerald-500";
                    } else {
                        dotColorClass = "bg-amber-500";
                    }
                }

                grid.innerHTML += `
                    <button onclick="selectCalendarDate('${dateKey}')" 
                            class="h-11 rounded-xl flex flex-col items-center justify-between p-1 transition border relative ${isSelected ? 'bg-amber-500 text-slate-900 font-bold border-amber-600 shadow-sm' : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-100'}">
                        <span class="text-[11px] leading-none">${day}</span>
                        ${countText ? `<span class="text-[8px] ${isSelected ? 'text-slate-900 font-extrabold' : 'text-slate-600 font-semibold'}">${countText}</span>` : '<span class="text-[8px] text-slate-300">-</span>'}
                        <span class="w-1.5 h-1.5 rounded-full ${dotColorClass}"></span>
                    </button>
                `;
            }
            renderIcons();
        }

        function selectCalendarDate(dateStr) {
            selectedDateStr = dateStr;
            renderCalendar();
            
            if (dailyDataCache[dateStr]) {
                renderReport(dailyDataCache[dateStr]);
            } else {
                fetchReportData(dateStr);
            }
        }

        async function syncCalendar() {
            const iconSync = document.getElementById("iconSync");
            const loading = document.getElementById("loadingIndicator");
            const loadingText = document.getElementById("loadingText");

            iconSync.classList.add("animate-spin");
            loadingText.innerText = "กำลังดึงข้อมูลปฏิทิน Google Calendar...";
            loading.classList.remove("hidden");

            try {
                const response = await fetch(`${SCRIPT_URL}?action=sync`, { redirect: "follow" });
                const res = await response.json();
                
                alert(res.message || "การดึงข้อมูลเสร็จสมบูรณ์");
                await initApp(true);

            } catch (err) {
                alert("เกิดข้อผิดพลาดในการดึงปฏิทิน: " + (err.message || err));
            } finally {
                iconSync.classList.remove("animate-spin");
                loading.classList.add("hidden");
            }
        }

        async function fetchReportData(dateStr) {
            const loading = document.getElementById("loadingIndicator");
            document.getElementById("loadingText").innerText = "กำลังโหลดข้อมูลรายละเอียด...";
            loading.classList.remove("hidden");

            try {
                const response = await fetch(`${SCRIPT_URL}?type=${currentTab}&date=${dateStr}`, { redirect: "follow" });
                const resData = await response.json();
                dailyDataCache[dateStr] = resData;
                renderReport(resData);
            } catch (err) {
                handleError(err);
            } finally {
                loading.classList.add("hidden");
            }
        }

        function formatBookingDescription(title, desc, location) {
            let fullText = (title + "\n" + desc).trim();

            let customerName = "";
            let phone = "";
            let line = "";
            let jobType = "";
            let placeName = "";
            let mapUrl = "";
            let bookingDocUrl = "";
            let note = "";

            const nameMatch = fullText.match(/(?:ชื่อ|ชื่อเล่น)\s*[:=]?\s*([^\n\r]+)/i);
            if (nameMatch) customerName = nameMatch[1].trim();

            const phoneMatch = fullText.match(/(?:โทร|เบอร์โทรศัพท์)\s*[:=]?\s*(\+?[0-9-]+)/i);
            if (phoneMatch) phone = phoneMatch[1].trim();

            const lineMatch = fullText.match(/LINE\s*[:=]?\s*([^\n\r]+)/i);
            if (lineMatch) line = lineMatch[1].trim();

            const typeMatch = fullText.match(/ประเภท\s*[:=]?\s*([^\n\r]+)/i);
            if (typeMatch) jobType = typeMatch[1].trim();

            const placeMatch = fullText.match(/ชื่อสถานที่\s*[:=]?\s*([^\n\r]+)/i);
            if (placeMatch) placeName = placeMatch[1].trim();
            else if (location) placeName = location;

            const mapMatch = fullText.match(/(https?:\/\/maps[^\s\n\r]+)/i);
            if (mapMatch) mapUrl = mapMatch[1];

            const docMatch = fullText.match(/(https?:\/\/[^\s\n\r]+booking[^\s\n\r]*)/i);
            if (docMatch) bookingDocUrl = docMatch[1];

            const noteMatch = fullText.match(/หมายเหตุ[^\n\r]*\n([\s\S]+?)(?=——|$)/i);
            if (noteMatch) note = noteMatch[1].trim();

            if (!customerName && !phone && !jobType && !placeName) {
                return `<div class="text-[11px] text-slate-600 whitespace-pre-line leading-relaxed">${fullText}</div>`;
            }

            let html = `<div class="space-y-1.5 text-[11px] text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-100">`;
            
            if (customerName || phone) html += `<div>👤 <strong>ลูกค้า:</strong> ${customerName || '-'} (${phone || 'ไม่ระบุเบอร์'})${line ? ` | LINE: ${line}` : ''}</div>`;
            if (jobType) html += `<div>📸 <strong>ประเภทงาน:</strong> ${jobType}</div>`;
            if (placeName) html += `<div>📍 <strong>โน้ต/คำอธิบาย:</strong> ${placeName} ${mapUrl ? `<a href="${mapUrl}" target="_blank" class="text-indigo-600 underline text-[10px] ml-1">[ดูแผนที่]</a>` : ''}</div>`;
            if (note) html += `<div class="text-slate-500 text-[10px] pt-1 border-t border-slate-200 mt-1">📝 <strong>หมายเหตุ:</strong> ${note}</div>`;
            if (bookingDocUrl) html += `<div class="pt-1"><a href="${bookingDocUrl}" target="_blank" class="text-amber-700 font-bold underline text-[10px] flex items-center gap-1"><i data-lucide="file-text" class="w-3 h-3"></i> ลิงก์ใบจองเอกสาร</a></div>`;

            html += `</div>`;
            return html;
        }

        function cleanHistoryText(rawHistoryText) {
            if (!rawHistoryText) return "";
            return rawHistoryText
                .replace(/\[ปรับเลื่อนเวลาแล้ว\]/, '')
                .replace(/GMT\+[0-9]+[^\n\r]*/g, '')
                .replace(/Sat|Sun|Mon|Tue|Wed|Thu|Fri|Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec/gi, '')
                .replace(/\b1899\b/g, '')
                .replace(/(\d{2}:\d{2}):\d{2}/g, '$1')
                .replace(/\s+/g, ' ')
                .trim();
        }

