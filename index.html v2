        async function initApp(forceRefresh = false) {
            const monthFormatted = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}`;
            document.getElementById("calendarMonthTitle").innerText = `${thaiMonths[currentMonth]} ${currentYear}`;
            document.getElementById("monthlyLabel").innerText = `${thaiMonths[currentMonth]} ${currentYear}`;

            const loading = document.getElementById("loadingIndicator");
            loading.classList.remove("hidden");

            if (forceRefresh) {
                monthlyDataCache = {};
                dailyDataCache = {};
            }

            try {
                const [monthlyRes, dailyRes] = await Promise.all([
                    fetch(`${SCRIPT_URL}?type=${currentTab}&month=${monthFormatted}`, { redirect: "follow" }).then(r => r.json()).catch(() => null),
                    fetch(`${SCRIPT_URL}?type=${currentTab}&date=${selectedDateStr}`, { redirect: "follow" }).then(r => r.json()).catch(() => null)
                ]);

                if (monthlyRes && monthlyRes.status === "success") {
                    monthlyDataCache = monthlyRes.data || {};
                }
                
                if (dailyRes && dailyRes.status === "success") {
                    dailyDataCache[selectedDateStr] = dailyRes;
                    renderReport(dailyRes);
                }
            } catch (err) {
                console.warn("Fast Fetch Error:", err);
            } finally {
                loading.classList.add("hidden");
                renderCalendar();
                calculateMonthlyTotals();
            }
        }

        function calculateMonthlyTotals() {
            const summaryCard = document.getElementById("summaryCardContainer");
            const ownerCommBox = document.getElementById("ownerCommBox");
            const ownerDailyCommContainer = document.getElementById("ownerDailyCommContainer");

            // หากอยู่ในหมวด PhotoBooth ให้ซ่อนส่วนสรุปคอมมิชชั่นออกทั้งหมด
            if (currentTab === 'photobooth') {
                if (isStaffMode) {
                    summaryCard.classList.add("hidden");
                } else {
                    summaryCard.classList.remove("hidden");
                    if (ownerCommBox) ownerCommBox.classList.add("hidden");
                    if (ownerDailyCommContainer) ownerDailyCommContainer.classList.add("hidden");
                }
            } else {
                summaryCard.classList.remove("hidden");
                if (ownerCommBox) ownerCommBox.classList.remove("hidden");
                if (ownerDailyCommContainer) ownerDailyCommContainer.classList.remove("hidden");
            }

            let mSales = 0;
            let mDeposit = 0;
            let mBaseCommission = 0;
            let mBonusCommission = 0;
            let totalQueues = 0;

            const pkgCounts = {};
            const bonusItems = [];

            Object.entries(monthlyDataCache).forEach(([dKey, d]) => {
                mSales += Number(d.totalSales || 0);
                mDeposit += Number(d.totalDeposit || 0);

                if (d.bookings && Array.isArray(d.bookings)) {
                    d.bookings.forEach(b => {
